DATABASE_URL=sqlite+aiosqlite:///./autopilot.db
# Or Postgres: postgresql+asyncpg://autopilot:autopilot@localhost:5432/autopilot
REDIS_URL=redis://localhost:6379/0
# Redis optional — gateway falls back to in-memory exact cache if Redis is down
GATEWAY_SECRET=dev-secret-change-me
MOCK_PROVIDERS=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
CACHE_TTL_SECONDS=86400
